<Window x:Class="MemOpz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MemOpz"
        Width="420"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        ShowInTaskbar="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                           ResizeBorderThickness="7"
                           GlassFrameThickness="0"
                           CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="17" Height="17" CornerRadius="4" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="M" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,-1,0,0"/>
                    </Border>
                    <TextBlock Text="MemOpz" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="9,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource CaptionButton}"
                            Content="&#x2014;"
                            Click="MinimizeButton_Click"/>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource CaptionCloseButton}"
                            Content="&#x2715;"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- 内容区 -->
            <StackPanel Grid.Row="1" Margin="24,0,24,22">

                <!-- 页头 -->
                <TextBlock Text="{DynamicResource PageTitle}"
                           FontSize="26" FontWeight="Bold"
                           Margin="2,0,0,2"/>
                <TextBlock Text="{DynamicResource PageSubtitle}"
                           FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="2,0,0,14"/>

                <!-- RAM 占用卡片 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource RamUsage}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Border x:Name="AdminBadge"
                                        BorderBrush="{DynamicResource BadgeBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4" Padding="7,1.5"
                                        Margin="9,0,0,0" Visibility="Collapsed">
                                    <TextBlock Text="{DynamicResource BadgeAdmin}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource LinkBrush}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock x:Name="UsedText" Text="--"
                                           FontSize="13" TextAlignment="Right"/>
                                <TextBlock x:Name="AvailableText" Text="--"
                                           FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="0,2,0,0" TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock x:Name="PercentText" Text="--"
                                       FontSize="46" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="54"/>
                            <TextBlock Text="%" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="3,16,0,0"/>
                        </StackPanel>

                        <ProgressBar x:Name="RamBar" Style="{StaticResource RamProgressBar}"
                                     Margin="0,10,0,0" Value="0"/>

                        <!-- 明细行 -->
                        <Grid Margin="0,13,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource SystemCache}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource CacheHint}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextQuaternaryBrush}"
                                           Margin="7,1,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="CacheText" Text="-- GB"
                                       FontSize="12.5" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 清理按钮 -->
                <Button x:Name="CleanButton"
                        Style="{StaticResource AccentButton}"
                        Margin="0,12"
                        Click="CleanButton_Click">
                    <Grid>
                        <TextBlock x:Name="CleanButtonText"
                                   Text="{DynamicResource CleanNow}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel x:Name="CleanBusyPanel" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <ProgressBar Style="{StaticResource ThinIndeterminate}"
                                         VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- 结果/进度区域（固定高度，避免窗口跳动） -->
                <Grid Height="42" Margin="2,0,2,2">
                    <!-- 清理中分阶段提示 -->
                    <StackPanel x:Name="ProgressPanel" Orientation="Horizontal"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="ProgressText" Text=""
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 清理结果 -->
                    <Grid x:Name="ResultPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="20" Height="20" CornerRadius="10"
                                Background="{DynamicResource AccentBrush}"
                                VerticalAlignment="Top"
                                Margin="0,1,10,0">
                            <TextBlock Text="&#x2713;" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-1,0,0"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ResultModeText" Text=""
                                           FontSize="13.5" FontWeight="SemiBold"/>
                                <TextBlock x:Name="FreedText" Text="--"
                                           FontSize="13.5" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="ResultDetailText"
                                       FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 选项卡片 -->
                <Border Style="{StaticResource Card}" Padding="16,8">
                    <StackPanel>

                        <!-- 高占用自动清理 -->
                        <Grid Margin="2,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource AutoCleanOption}"
                                       FontSize="13.5" VerticalAlignment="Center"/>
                            <CheckBox x:Name="AutoCleanToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="AutoCleanToggle_Changed"
                                      Unchecked="AutoCleanToggle_Changed"/>
                        </Grid>

                        <!-- 阈值设置 -->
                        <Grid x:Name="ThresholdPanel" Margin="6,2,4,7"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Threshold}"
                                       FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Slider x:Name="ThresholdSlider"
                                    Grid.Column="1"
                                    Style="{StaticResource ThresholdSlider}"
                                    Margin="12,0,10,0"
                                    ValueChanged="ThresholdSlider_ValueChanged"/>
                            <TextBlock x:Name="ThresholdValueText" Text="90%"
                                       Grid.Column="2"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Width="38"
                                       TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="2,2"/>

                        <!-- 开机自启动 -->
                        <Grid Margin="2,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource AutoStartOption}"
                                       FontSize="13.5" VerticalAlignment="Center"/>
                            <CheckBox x:Name="AutoStartToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="AutoStartToggle_Changed"
                                      Unchecked="AutoStartToggle_Changed"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="2,2"/>

                        <!-- 检测间隔 -->
                        <Grid Margin="2,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource RefreshInterval}"
                                       FontSize="13.5" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource SegmentedGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Interval1" Tag="1"
                                                 Style="{StaticResource SegmentedItem}"
                                                 Content="1s" GroupName="Interval"
                                                 Checked="Interval_Checked"/>
                                    <RadioButton x:Name="Interval2" Tag="2"
                                                 Style="{StaticResource SegmentedItem}"
                                                 Content="2s" GroupName="Interval"
                                                 Checked="Interval_Checked"/>
                                    <RadioButton x:Name="Interval5" Tag="5"
                                                 Style="{StaticResource SegmentedItem}"
                                                 Content="5s" GroupName="Interval"
                                                 Checked="Interval_Checked"/>
                                    <RadioButton x:Name="Interval10" Tag="10"
                                                 Style="{StaticResource SegmentedItem}"
                                                 Content="10s" GroupName="Interval"
                                                 Checked="Interval_Checked"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="2,2"/>

                        <!-- 语言 -->
                        <Grid Margin="2,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource LanguageLabel}"
                                       FontSize="13.5" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource SegmentedGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="LangZh" Tag="zh-CN"
                                                 Style="{StaticResource SegmentedItem}"
                                                 Content="中文" GroupName="Language"
                                                 Checked="Language_Checked"/>
                                    <RadioButton x:Name="LangEn" Tag="en-US"
                                                 Style="{StaticResource SegmentedItem}"
                                                 Content="EN" GroupName="Language"
                                                 Checked="Language_Checked"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 底部：管理员提升入口 -->
                <TextBlock x:Name="ElevationLink"
                           Margin="2,11,2,0"
                           FontSize="11.5"
                           Foreground="{DynamicResource LinkBrush}"
                           TextDecorations="Underline"
                           Cursor="Hand"
                           Visibility="Collapsed"
                           Text="{DynamicResource ElevateHint}"
                           TextWrapping="Wrap"
                           MouseLeftButtonUp="ElevationLink_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
