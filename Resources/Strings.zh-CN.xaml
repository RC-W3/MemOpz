<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="AppName">MemOpz</sys:String>
    <sys:String x:Key="PageTitle">内存清理</sys:String>
    <sys:String x:Key="PageSubtitle">监控内存占用，一键释放系统与进程冗余内存</sys:String>

    <sys:String x:Key="RamUsage">RAM 占用</sys:String>
    <sys:String x:Key="BadgeAdmin">管理员</sys:String>
    <sys:String x:Key="UsedFormat">已用 {0} / {1} GB</sys:String>
    <sys:String x:Key="AvailableFormat">可用 {0} GB</sys:String>
    <sys:String x:Key="SystemCache">系统缓存</sys:String>
    <sys:String x:Key="CacheHint">待机列表与已修改内存页</sys:String>

    <sys:String x:Key="CleanNow">立即清理内存</sys:String>
    <sys:String x:Key="StagePrep">正在准备…</sys:String>
    <sys:String x:Key="StageSystemWorkingSets">正在清空系统工作集…</sys:String>
    <sys:String x:Key="StageModifiedList">正在回写已修改内存页…</sys:String>
    <sys:String x:Key="StageStandbyList">正在清空待机内存缓存…</sys:String>
    <sys:String x:Key="StageProcesses">正在整理各进程内存…</sys:String>
    <sys:String x:Key="StageManaged">正在回收托管内存…</sys:String>

    <sys:String x:Key="FreedManual">已释放</sys:String>
    <sys:String x:Key="FreedAuto">自动清理已释放</sys:String>
    <sys:String x:Key="ResultDetailFormat">可用 {0} GB → {1} GB · {2}</sys:String>
    <sys:String x:Key="ResultCleanFormat">内存已处于较干净状态 · {0}</sys:String>

    <sys:String x:Key="AutoCleanOption">RAM 占用过高时自动清理</sys:String>
    <sys:String x:Key="Threshold">阈值</sys:String>
    <sys:String x:Key="AutoStartOption">开机时自动启动</sys:String>
    <sys:String x:Key="RefreshInterval">检测间隔</sys:String>
    <sys:String x:Key="LanguageLabel">语言</sys:String>

    <sys:String x:Key="ElevateHint">深度清理（清空待机内存与系统工作集）需要管理员权限，点此以管理员身份重启</sys:String>
    <sys:String x:Key="CleanFailedFormat">清理失败：{0}</sys:String>
    <sys:String x:Key="AutoStartFailedFormat">设置开机自启动失败：{0}</sys:String>

</ResourceDictionary>
