<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="AppName">MemOpz</sys:String>
    <sys:String x:Key="PageTitle">Memory Cleanup</sys:String>
    <sys:String x:Key="PageSubtitle">Monitor RAM usage and release cached and process memory</sys:String>

    <sys:String x:Key="RamUsage">RAM Usage</sys:String>
    <sys:String x:Key="BadgeAdmin">Admin</sys:String>
    <sys:String x:Key="UsedFormat">Used {0} / {1} GB</sys:String>
    <sys:String x:Key="AvailableFormat">Available {0} GB</sys:String>
    <sys:String x:Key="SystemCache">System Cache</sys:String>
    <sys:String x:Key="CacheHint">Standby list and modified pages</sys:String>

    <sys:String x:Key="CleanNow">Clean Up Memory</sys:String>
    <sys:String x:Key="StagePrep">Preparing…</sys:String>
    <sys:String x:Key="StageSystemWorkingSets">Clearing system working sets…</sys:String>
    <sys:String x:Key="StageModifiedList">Flushing modified pages…</sys:String>
    <sys:String x:Key="StageStandbyList">Purging standby cache…</sys:String>
    <sys:String x:Key="StageProcesses">Trimming process memory…</sys:String>
    <sys:String x:Key="StageManaged">Reclaiming managed memory…</sys:String>

    <sys:String x:Key="FreedManual">Freed</sys:String>
    <sys:String x:Key="FreedAuto">Auto cleanup freed</sys:String>
    <sys:String x:Key="ResultDetailFormat">Available {0} GB → {1} GB · {2}</sys:String>
    <sys:String x:Key="ResultCleanFormat">Memory is already clean · {0}</sys:String>

    <sys:String x:Key="AutoCleanOption">Auto-clean when RAM usage is high</sys:String>
    <sys:String x:Key="Threshold">Threshold</sys:String>
    <sys:String x:Key="AutoStartOption">Start when Windows starts</sys:String>
    <sys:String x:Key="RefreshInterval">Refresh interval</sys:String>
    <sys:String x:Key="LanguageLabel">Language</sys:String>

    <sys:String x:Key="ElevateHint">Deep cleanup (purging standby list and system working sets) requires administrator rights. Click to restart as administrator.</sys:String>
    <sys:String x:Key="CleanFailedFormat">Cleanup failed: {0}</sys:String>
    <sys:String x:Key="AutoStartFailedFormat">Failed to configure auto-start: {0}</sys:String>

</ResourceDictionary>
