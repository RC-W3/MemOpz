<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题（Windows 浅色） -->
    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1F"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#3F3F46"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6E6E73"/>
    <SolidColorBrush x:Key="TextQuaternaryBrush" Color="#8A8A8F"/>

    <SolidColorBrush x:Key="CardBrush" Color="#0A000000"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#10000000"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#0F000000"/>

    <!-- 金色强调色（浅底下加深以保证对比） -->
    <SolidColorBrush x:Key="AccentBrush" Color="#C9A23A"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D9B44A"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#B8902A"/>
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#E4D6A8"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#1B1B1F"/>
    <SolidColorBrush x:Key="AccentButtonDisabledTextBrush" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="LinkBrush" Color="#9A7417"/>
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#A88438"/>

    <!-- 控件 -->
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#838383"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#18000000"/>
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0D000000"/>
    <SolidColorBrush x:Key="SegmentedTrackBrush" Color="#0C000000"/>
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#C42B1C"/>

</ResourceDictionary>
