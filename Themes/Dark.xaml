<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题（Windows 深色） -->
    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#202024"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9B9B9B"/>
    <SolidColorBrush x:Key="TextQuaternaryBrush" Color="#6F6F6F"/>

    <SolidColorBrush x:Key="CardBrush" Color="#0CFFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#12FFFFFF"/>

    <!-- 金色强调色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#D9B44A"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#E6C76B"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#C49E35"/>
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#5A4E2C"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#1B1B1F"/>
    <SolidColorBrush x:Key="AccentButtonDisabledTextBrush" Color="#B5B5B5"/>
    <SolidColorBrush x:Key="LinkBrush" Color="#E6C76B"/>
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#6E5C28"/>

    <!-- 控件 -->
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="SegmentedTrackBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#C42B1C"/>

</ResourceDictionary>
